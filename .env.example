# NexusAI 环境变量配置
# 复制此文件为 .env 并修改相应值

# 会话密钥（必须修改为随机字符串）
SESSION_SECRET=your-random-session-secret-key-here

# 加密密钥（必须修改为随机字符串）
CRYPTO_SECRET=your-random-crypto-secret-key-here

# Redis 密码（可选）
REDIS_PASSWORD=

# 服务端口
PORT=3000

# 时区
TZ=Asia/Shanghai

# 支付配置（可选）
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# 邮件配置（可选）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=